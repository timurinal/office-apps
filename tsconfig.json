{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "paths": {
      "@web/*": ["./web/src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["web/src", "shared", "tests", "vite.config.ts", "vite.exact-case.ts", "vitest.config.ts"],
  // ExcelJS declares a global `Buffer` that is an ArrayBuffer; these two hand it a Node
  // Buffer, which is right at run time and wrong to tsc. Vitest still runs them.
  "exclude": ["web/src/formats/xlsx/write.test.ts", "web/src/sheets/darkCells.export.test.ts", "tests/corpus/xlsx/corpus.test.ts"]
}
